{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm:*)",
      "Bash(npm:*)",
      "Bash(turbo:*)",
      "Bash(next:*)",
      "Bash(storybook:*)",
      "Bash(tsc:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git reset:*)",
      "Bash(curl:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(ls:*)"
    ],
    "ask": ["Bash(rm:*)", "Bash(git push:*)", "Bash(git reset --hard:*)"],
    "deny": ["Bash(rm -rf /)", "Bash(rm -rf ~)"]
  }
}
