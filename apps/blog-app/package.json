{
  "name": "web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm dev:next\" \"pnpm dev:mock\" \"pnpm dev:ui\" -c \"yellow,blue,green\"",
    "dev:next": "next dev --turbopack --port 3000",
    "dev:mock": "tsx watch mock-server/server.ts",
    "dev:ui": "pnpm --filter @repo/ui dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@repo/ui": "workspace:*",
    "@tailwindcss/postcss": "4.3.0",
    "next": "16.2.6",
    "postcss": "8.5.14",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwindcss": "4.3.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "concurrently": "9.2.1",
    "tsx": "4.22.0",
    "typescript": "6.0.3"
  }
}
